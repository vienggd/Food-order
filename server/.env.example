# Copy to server/.env and fill in. server/.env is never committed.
# Local Docker database (docker-compose.yml). Port 5433 on your computer.
DATABASE_URL="postgresql://cafe:cafe@localhost:5433/cafe"
# Separate database for automated tests (wiped on every test run).
TEST_DATABASE_URL="postgresql://cafe:cafe@localhost:5433/cafe_test"
# Password for the seeded accounts (alice@cafe.test, bob@cafe.test, staff@cafe.test).
# Choose your own. Never put the real value in Git, chat or the PDF.
SEED_PASSWORD=""
PORT=3000
