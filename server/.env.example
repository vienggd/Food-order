# Every environment variable the server reads. Placeholders only.
# Copy to server/.env and fill in. server/.env is never committed.
# On Cloud Run the same names are set by the deploy (secrets come from Secret Manager).

# Database the app uses. Local Docker database (docker-compose.yml) is on port 5433.
DATABASE_URL="postgresql://cafe:cafe@localhost:5433/cafe"
# Separate database for automated tests (wiped on every test run). Must be local and end in _test.
TEST_DATABASE_URL="postgresql://cafe:cafe@localhost:5433/cafe_test"
# Password for the seeded accounts (alice@cafe.test, bob@cafe.test, staff@cafe.test).
# Choose your own. Never put the real value in Git, chat or the PDF.
SEED_PASSWORD=""
# Optional. When set, the seed also creates the smoke-test customer smoke@cafe.test with this password.
# SMOKE_PASSWORD=""
# Port the server listens on. Cloud Run sets it for you.
PORT=3000
# "production" on Cloud Run (secure session cookie). Leave unset locally.
# NODE_ENV=production
# Optional. Folder with the built React app that the server serves. Default: ../client/dist
# CLIENT_DIST=../client/dist
